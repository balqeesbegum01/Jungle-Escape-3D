
import bpy
import math

# Clear everything
bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.delete(use_global=False)

# Materials
def material(name, color):
    mat = bpy.data.materials.new(name)
    mat.diffuse_color = (*color, 1)
    return mat

skin = material("Skin", (0.75, 0.43, 0.25))
shirt = material("Blue Shirt", (0.02, 0.15, 0.8))
pants = material("Black Pants", (0.04, 0.04, 0.06))
shoes = material("White Shoes", (0.9, 0.9, 0.9))
hair = material("Black Hair", (0.03, 0.02, 0.01))

# Create a cube
def cube(name, location, scale, mat):
    bpy.ops.mesh.primitive_cube_add(size=1, location=location)
    obj = bpy.context.object
    obj.name = name
    obj.dimensions = scale
    bpy.ops.object.transform_apply(
        location=False, rotation=False, scale=True
    )
    obj.data.materials.append(mat)
    bevel = obj.modifiers.new("Soft Edges", "BEVEL")
    bevel.width = 0.08
    bevel.segments = 3
    obj.modifiers.new("Normals", "WEIGHTED_NORMAL")
    return obj

# Create a sphere
def sphere(name, location, scale, mat):
    bpy.ops.mesh.primitive_uv_sphere_add(
        segments=24, ring_count=16,
        location=location
    )
    obj = bpy.context.object
    obj.name = name
    obj.scale = scale
    obj.data.materials.append(mat)
    bpy.ops.object.shade_smooth()
    return obj

# HEAD
sphere("Human Head", (0, 0, 2.25), (0.28, 0.27, 0.32), skin)

# HAIR
sphere("Hair", (0, 0.02, 2.47), (0.29, 0.28, 0.16), hair)

# BODY
cube("Blue Shirt", (0, 0, 1.55), (0.65, 0.35, 0.85), shirt)

# NECK
cube("Neck", (0, 0, 2.02), (0.18, 0.18, 0.18), skin)

# ARMS
for side in [-1, 1]:
    arm = cube(
        "Arm",
        (side * 0.46, 0, 1.55),
        (0.20, 0.24, 0.75),
        shirt
    )
    arm.rotation_euler[1] = side * -0.15

    sphere(
        "Hand",
        (side * 0.49, 0, 1.13),
        (0.12, 0.12, 0.13),
        skin
    )

# LEGS AND SHOES
for side in [-1, 1]:
    cube(
        "Black Pants",
        (side * 0.19, 0, 0.83),
        (0.24, 0.30, 0.85),
        pants
    )

    cube(
        "White Shoes",
        (side * 0.19, -0.08, 0.35),
        (0.30, 0.48, 0.20),
        shoes
    )

# Select all objects for export
bpy.ops.object.select_all(action='SELECT')

# Export GLB
bpy.ops.export_scene.gltf(
    filepath=bpy.path.abspath("//player.glb"),
    export_format='GLB',
    use_selection=True
)

print("PLAYER.GLB CREATED SUCCESSFULLY!")

